<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Macro for the Curved Pads -->
  <xacro:macro name="finger_pad" params="side finger parent tip_slot_pos">
    <joint name="${side}_gripper_${finger}_pad_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${side}_gripper_${finger}_pad"/>
    </joint>

    <link name="${side}_gripper_${finger}_pad">
      <visual>
        <xacro:if value="${finger == 'l'}">
          <!-- Back to perfect face with 0.1mm gap to stop flickering -->
          <origin rpy="0 0 ${-pi/2}" xyz="0 -0.0036 ${0.0726-((tip_slot_pos-1)*0.015)}"/>
        </xacro:if>
        <xacro:if value="${finger == 'r'}">
          <!-- Back to perfect face with 0.1mm gap to stop flickering -->
          <origin rpy="0 0 ${pi/2}" xyz="0 0.0036 ${0.0726-((tip_slot_pos-1)*0.015)}"/>
        </xacro:if>
        <geometry>
          <mesh filename="package://tossingbot_gripper_description/meshes/STL/pneumatic_finger_tip.STL" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="TossingBot/DarkGrey"/>
      </visual>
      <collision>
        <xacro:if value="${finger == 'l'}">
          <origin rpy="0 0 ${-pi/2}" xyz="0 -0.0036 ${0.0726-((tip_slot_pos-1)*0.015)}"/>
        </xacro:if>
        <xacro:if value="${finger == 'r'}">
          <origin rpy="0 0 ${pi/2}" xyz="0 0.0036 ${0.0726-((tip_slot_pos-1)*0.015)}"/>
        </xacro:if>
        <geometry>
          <mesh filename="package://tossingbot_gripper_description/meshes/STL/pneumatic_finger_tip.STL" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <xacro:if value="${finger == 'l'}">
          <origin rpy="0 0 ${-pi/2}" xyz="0 -0.0036 ${0.0726-((tip_slot_pos-1)*0.015)}"/>
        </xacro:if>
        <xacro:if value="${finger == 'r'}">
          <origin rpy="0 0 ${pi/2}" xyz="0 0.0036 ${0.0726-((tip_slot_pos-1)*0.015)}"/>
        </xacro:if>
        <mass value="0.040"/>
        <inertia ixx="0.0000064492" ixy="-2.802891E-8" ixz="-2.65457E-9" iyy="0.0000019488" iyz="1.4972E-10" izz="0.0000057675"/>
      </inertial>
    </link>

    <gazebo reference="${side}_gripper_${finger}_pad">
      <material>Gazebo/DarkGrey</material>
      <mu1>1000000.0</mu1>
      <mu2>1000000.0</mu2>
    </gazebo>
  </xacro:macro>
</robot>
